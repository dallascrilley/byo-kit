{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://byo-kit.invalid/schemas/concept.schema.json",
  "title": "BYO Kit concept manifest",
  "description": "A portable, pre-researched project concept accepted by the byo-kit scaffold CLI.",
  "type": "object",
  "required": ["problem", "user", "standout", "demo_steps"],
  "anyOf": [{ "required": ["name"] }, { "required": ["title"] }],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "problem": { "type": "string", "minLength": 1 },
    "user": { "type": "string", "minLength": 1 },
    "standout": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "object", "required": ["name", "description"], "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }, "additionalProperties": true }
      ]
    },
    "demo_steps": { "type": "array", "minItems": 1, "items": { "oneOf": [
      { "type": "string", "minLength": 1 },
      { "type": "object", "minProperties": 1 }
    ] } },
    "kind": { "enum": ["web", "cli", "library"] },
    "ai": { "type": "boolean", "default": false },
    "prior_art": {
      "type": "object",
      "required": ["decision", "references", "rationale"],
      "properties": {
        "decision": { "enum": ["extend", "contribute", "wrap", "new"] },
        "references": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "description": { "type": "string" },
    "proof_plan": {
      "description": "Optional public capability proof plan. Hypotheses are not findings; project evidence cannot establish professional tenure. Never include job or employer context.",
      "type": "object",
      "required": ["capability", "baseline", "acceptance", "case_study_hypothesis"],
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "baseline": { "type": "string", "minLength": 1 },
        "case_study_hypothesis": { "type": "string", "minLength": 1 },
        "acceptance": { "type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["input", "expected", "failure"],
          "properties": {
            "input": { "type": "string", "minLength": 1 },
            "expected": { "type": "string", "minLength": 1 },
            "failure": { "type": "string", "minLength": 1 }
          }, "additionalProperties": false
        } }
      }, "additionalProperties": false
    },
    "sample_data": { "type": "array", "items": { "type": "object" } },
    "features": { "type": "array", "items": { "type": "string" } },
    "openrouter": { "type": "boolean", "default": false }
  },
  "additionalProperties": true
}
